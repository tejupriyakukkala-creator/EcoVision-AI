# ==========================================
# EcoVision AI - Environment Configuration
# ==========================================

# Backend Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=ecovision-super-secret-key-change-in-production-2026
MONGODB_URI=mongodb://127.0.0.1:27017/ecovision

# AI Inference Service
AI_SERVICE_URL=http://127.0.0.1:8000
YOLO_MODEL_PATH=models/weights/ecovision_yolov8n.pt
CNN_MODEL_PATH=models/weights/waste_cnn_resnet18.pth
YOLO_CONF_THRESHOLD=0.25
CNN_CONF_THRESHOLD=0.40
FUSION_HIGH_CONF_THRESHOLD=0.65
DEVICE=cpu

# Arduino Hardware Integration
ARDUINO_PORT=COM3
ARDUINO_BAUDRATE=9600
ARDUINO_SIMULATION_MODE=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
